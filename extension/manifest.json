{
  "manifest_version": 3,
  "name": "本地券后价助手",
  "version": "0.1.0",
  "permissions": ["alarms", "tabs"],
  "host_permissions": ["https://*.jd.com/*", "http://localhost:8000/*"],
  "background": {"service_worker": "service-worker.js", "type": "module"},
  "content_scripts": [{"matches": ["https://*.jd.com/*"], "js": ["content/jd-parser.js", "content/jd-content.js"], "run_at": "document_idle"}]
}
